    "NSAudioCaptureUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EchoBar captures audio played by apps and saves recordings on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回声会录制应用播放的声音，并将录音保存在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回聲會錄製 App 播放的聲音，並將錄音儲存在這台 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EchoBarはアプリが再生する音声を録音し、このMacに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "EchoBar는 앱에서 재생되는 소리를 녹음하여 이 Mac에 저장합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل EchoBar الصوت الذي تشغّله التطبيقات ويحفظ التسجيلات على هذا الـ Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EchoBar enregistre le son des apps et sauvegarde les fichiers sur ce Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "EchoBar записывает звук приложений и сохраняет записи на этом Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EchoBar captura el audio de las apps y guarda las grabaciones en este Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EchoBar nimmt den Ton von Apps auf und speichert die Aufnahmen auf diesem Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O EchoBar grava o áudio dos apps e salva as gravações neste Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "EchoBar registra l’audio delle app e salva le registrazioni su questo Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "EchoBar ऐप्स की ध्वनि रिकॉर्ड करके इसी Mac पर सहेजता है।"
          }
        }
      }
    }
  },
  "version": "1.0"
