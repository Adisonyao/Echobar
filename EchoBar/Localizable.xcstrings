        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 오디오 형식을 지원하지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق الصوت الحالي غير مدعوم."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format audio actuel n’est pas pris en charge."
          }
        },
