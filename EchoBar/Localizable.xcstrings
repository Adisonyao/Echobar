          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato de áudio atual não é compatível."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formato audio attuale non è supportato."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान ऑडियो फ़ॉर्मैट समर्थित नहीं है।"
          }
        }
      }
    },
    "error.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No system audio was received. Play audio and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未收到系统音频。播放声音后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未收到系統音訊。播放聲音後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム音声が届きませんでした。音声を再生してやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 오디오를 받지 못했습니다. 소리를 재생하고 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصل صوت النظام. شغّل صوتًا وحاول مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun son système reçu. Lancez une lecture audio et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук системы не поступил. Включите звук и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se recibió audio del sistema. Reproduce sonido e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Systemaudio empfangen. Spiele Ton ab und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum áudio do sistema recebido. Reproduza um som e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun audio di sistema ricevuto. Riproduci un suono e riprova."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम ऑडियो नहीं मिला। कोई ध्वनि चलाकर फिर कोशिश करें।"
          }
        }
      }
    },
