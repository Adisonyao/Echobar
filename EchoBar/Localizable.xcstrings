          "stringUnit": {
            "state": "translated",
            "value": "Spettro in tempo reale, bassi a sinistra e alti a destra"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव स्पेक्ट्रम, कम आवृत्तियाँ बाईं ओर और ऊँची दाईं ओर"
          }
        }
      }
    },
    "error.audio": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio operation failed (%@). If the error persists, check system audio recording access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频操作失败（%@）。若持续失败，请检查系统音频录制权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊操作失敗（%@）。若持續失敗，請檢查系統音訊錄製權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声処理に失敗しました（%@）。続く場合はシステム音声の録音権限を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 작업 실패(%@). 계속 실패하면 시스템 오디오 녹음 권한을 확인하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت عملية الصوت (%@). إذا استمرت المشكلة، فتحقق من إذن تسجيل صوت النظام."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’opération audio (%@). Si le problème persiste, vérifiez l’autorisation d’enregistrer l’audio système."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбой аудиооперации (%@). Если ошибка повторяется, проверьте разрешение на запись звука системы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de audio (%@). Si persiste, revisa el permiso para grabar el audio del sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audiovorgang fehlgeschlagen (%@). Prüfe bei wiederholtem Fehler die Berechtigung zur Systemaudioaufnahme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na operação de áudio (%@). Se persistir, verifique a permissão para gravar o áudio do sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Operazione audio non riuscita (%@). Se il problema persiste, verifica il permesso di registrare l’audio di sistema."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो कार्रवाई विफल (%@)। समस्या बनी रहे तो सिस्टम ऑडियो रिकॉर्डिंग की अनुमति जाँचें।"
          }
        }
      }
    },
    "error.format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current audio format is unsupported."
          }
        },
        "zh-Hans": {
